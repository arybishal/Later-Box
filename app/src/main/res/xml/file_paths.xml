<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Cache directory for downloaded update APKs -->
    <cache-path name="update_cache" path="updates/" />
    <!-- App-specific external cache for updates if needed -->
    <external-cache-path name="ext_update_cache" path="updates/" />
    <!-- App-specific external files dir -->
    <external-files-path name="ext_update_files" path="updates/" />
    <!-- Camera and captured media paths -->
    <cache-path name="camera_cache" path="camera/" />
    <files-path name="internal_files" path="." />
    <cache-path name="internal_cache" path="." />
</paths>
